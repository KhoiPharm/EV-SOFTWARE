# Copy this file to .env for local development only.
# Values below are intentionally non-production placeholders.
EV_ENVIRONMENT=development
EV_APPLICATION_NAME=EV Scanner
EV_LOG_LEVEL=INFO
EV_HOST=127.0.0.1
EV_PORT=8000
EV_PRESENTATION_TIMEZONE=Australia/Sydney
EV_DATABASE_URL=postgresql+psycopg://ev_scanner:local_dev_only@127.0.0.1:5432/ev_scanner

# Docker Compose database bootstrap values.
EV_DB_USER=ev_scanner
EV_DB_PASSWORD=local_dev_only
EV_DB_NAME=ev_scanner
EV_DB_PORT=5432
